# OpenAI-compatible LLM
# Use OPENAI_API_KEY for OpenAI directly.
# Use LLM_API_KEY + LLM_BASE_URL if switching to another OpenAI-compatible provider.
OPENAI_API_KEY=your_openai_api_key
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
DEBUG_LLM=false

# GitHub
GITHUB_TOKEN=your_github_token
GITHUB_REPO=owner/repo
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT=45
GITHUB_MAX_RETRIES=3
GITHUB_COMMIT_AUTHOR_NAME=EngineerAgent
GITHUB_COMMIT_AUTHOR_EMAIL=agent@launchmind.ai
GITHUB_COMMITTER_NAME=EngineerAgent
GITHUB_COMMITTER_EMAIL=agent@launchmind.ai

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Use a channel ID like C12345678, a name like launches, or #launches
SLACK_CHANNEL=launches
SLACK_API_BASE_URL=https://slack.com/api
SLACK_TIMEOUT=30
SLACK_MAX_RETRIES=3

# Email - SendGrid primary
SENDGRID_API_KEY=your_sendgrid_api_key
VERIFIED_SENDER_EMAIL=verified-sender@example.com
FROM_EMAIL=
TEST_RECIPIENT_EMAIL=test-inbox@example.com
EMAIL_TIMEOUT=30
EMAIL_MAX_RETRIES=3

# Email - SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional startup override
STARTUP_IDEA=
